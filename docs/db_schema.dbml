```dbml
// ============================================================
// OPSFLOW DATABASE SCHEMA
// DBML / dbdiagram.io
// ============================================================

// ============================================================
// ENUM TYPES
// ============================================================

Enum user_status {
  active
  inactive
  suspended
}

Enum project_status {
  planning
  active
  on_hold
  completed
  delayed
  cancelled
}

Enum priority_level {
  low
  medium
  high
  critical
}

Enum task_status {
  pending
  in_progress
  blocked
  completed
}

Enum client_status {
  active
  inactive
  archived
}

Enum notification_type {
  task
  project
  user
  system
}

// ============================================================
// ROLES
// ============================================================

Table roles {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(50) [not null, unique]
  description text

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Defines application-level roles and permissions.'
}

// ============================================================
// DEPARTMENTS
// ============================================================

Table departments {
  id uuid [pk, default: `uuid_generate_v4()`]
  name varchar(100) [not null, unique]
  description text

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Organizational departments to which users can belong.'
}

// ============================================================
// USERS
// ============================================================

Table users {
  id uuid [pk, default: `uuid_generate_v4()`]

  name varchar(150) [not null]
  email varchar(255) [not null, unique]

  auth_id uuid [unique, note: 'References the authentication provider user ID, e.g. Supabase Auth.']

  role_id uuid [not null]
  department_id uuid

  phone varchar(30)
  position varchar(100)
  avatar_url text

  status user_status [not null, default: 'active']

  joined_at date

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Application user profile linked to the authentication provider.'
}

// ============================================================
// CLIENTS
// ============================================================

Table clients {
  id uuid [pk, default: `uuid_generate_v4()`]

  name varchar(150) [not null]
  company varchar(200)

  email varchar(255)
  phone varchar(30)

  address text

  status client_status [not null, default: 'active']

  notes text

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'External clients or organizations associated with projects.'
}

// ============================================================
// PROJECTS
// ============================================================

Table projects {
  id uuid [pk, default: `uuid_generate_v4()`]

  name varchar(200) [not null]
  description text

  client_id uuid
  manager_id uuid

  status project_status [not null, default: 'planning']

  priority priority_level [not null, default: 'medium']

  progress integer [not null, default: 0, note: 'Value between 0 and 100.']

  start_date date
  deadline date

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Core operational projects managed within OpsFlow.'
}

// ============================================================
// PROJECT MEMBERS
// ============================================================

Table project_members {
  id uuid [pk, default: `uuid_generate_v4()`]

  project_id uuid [not null]
  user_id uuid [not null]

  joined_at timestamp [not null, default: `now()`]

  indexes {
    (project_id, user_id) [unique]
  }

  Note: 'Many-to-many relationship between users and projects.'
}

// ============================================================
// TASKS
// ============================================================

Table tasks {
  id uuid [pk, default: `uuid_generate_v4()`]

  project_id uuid [not null]
  assigned_to uuid
  created_by uuid

  title varchar(200) [not null]
  description text

  status task_status [not null, default: 'pending']

  priority priority_level [not null, default: 'medium']

  due_date date
  completed_at timestamp

  created_at timestamp [not null, default: `now()`]
  updated_at timestamp [not null, default: `now()`]

  Note: 'Operational tasks belonging to projects and assigned to users.'
}

// ============================================================
// ACTIVITY LOGS
// ============================================================

Table activity_logs {
  id uuid [pk, default: `uuid_generate_v4()`]

  user_id uuid

  action varchar(100) [not null]

  entity_type varchar(50) [not null]
  entity_id uuid

  description text

  metadata jsonb

  created_at timestamp [not null, default: `now()`]

  Note: 'Audit-style activity history for important system actions.'
}

// ============================================================
// NOTIFICATIONS
// ============================================================

Table notifications {
  id uuid [pk, default: `uuid_generate_v4()`]

  user_id uuid [not null]

  title varchar(200) [not null]
  message text [not null]

  type notification_type [not null, default: 'system']

  is_read boolean [not null, default: false]

  created_at timestamp [not null, default: `now()`]

  Note: 'User-specific system notifications.'
}

// ============================================================
// RELATIONSHIPS
// ============================================================

// Users → Roles
Ref user_role: users.role_id > roles.id

// Users → Departments
Ref user_department: users.department_id > departments.id

// Projects → Clients
Ref project_client: projects.client_id > clients.id

// Projects → Managers
Ref project_manager: projects.manager_id > users.id

// Project Members
Ref project_members_project: project_members.project_id > projects.id
Ref project_members_user: project_members.user_id > users.id

// Tasks
Ref task_project: tasks.project_id > projects.id
Ref task_assignee: tasks.assigned_to > users.id
Ref task_creator: tasks.created_by > users.id

// Activity Logs
Ref activity_user: activity_logs.user_id > users.id

// Notifications
Ref notification_user: notifications.user_id > users.id

// ============================================================
// INDEXES
// ============================================================

Table users {
  indexes {
    role_id
    department_id
    status
  }
}

Table projects {
  indexes {
    client_id
    manager_id
    status
    deadline
  }
}

Table project_members {
  indexes {
    project_id
    user_id
  }
}

Table tasks {
  indexes {
    project_id
    assigned_to
    status
    due_date
  }
}

Table activity_logs {
  indexes {
    user_id
    (entity_type, entity_id)
    created_at
  }
}

Table notifications {
  indexes {
    user_id
    is_read
  }
}

// ============================================================
// SEED DATA
// ============================================================

Table roles_seed {
  name varchar
  description text

  Note: 'Seed data reference — actual INSERT statements remain in PostgreSQL schema.sql.'
}

Table departments_seed {
  name varchar
  description text

  Note: 'Seed data reference — actual INSERT statements remain in PostgreSQL schema.sql.'
}
```
