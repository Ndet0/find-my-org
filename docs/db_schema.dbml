// ============================================================
// OPSFLOW DATABASE SCHEMA
// DBML / dbdiagram.io
//
// Follows packages/db/prisma/schema.prisma, which is the source
// of truth. Paste this file into https://dbdiagram.io to render
// the full ERD; docs/db_schema.md carries a condensed Mermaid
// version of the same model.
//
// Primary keys are UUIDv7 generated by Prisma's @default(uuid(7)),
// not by a database default, so no `default` is declared on them.
// ============================================================

// ============================================================
// ENUM TYPES
// ============================================================

Enum user_status {
  active
  inactive
  suspended
}

Enum project_status {
  planning
  active
  on_hold
  completed
  delayed
  cancelled
}

Enum priority_level {
  low
  medium
  high
  critical
}

Enum task_status {
  pending
  in_progress
  blocked
  completed
}

Enum client_status {
  active
  inactive
  archived
}

Enum notification_type {
  task
  project
  user
  system
}

// ============================================================
// ROLES
// ============================================================

Table roles {
  id uuid [pk]

  name varchar(50) [not null, unique]
  description text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: 'Defines application-level roles: admin, manager, employee.'
}

// ============================================================
// DEPARTMENTS
// ============================================================

Table departments {
  id uuid [pk]

  name varchar(100) [not null, unique]
  description text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  Note: 'Organizational departments to which users can belong.'
}

// ============================================================
// USERS
//
// Both the Better Auth user record and the OPSflow employee
// profile. There is no separate profile table and no auth_id
// column: Better Auth writes into this database, so the
// external-provider indirection is unnecessary.
// ============================================================

Table users {
  id uuid [pk]

  name varchar(150) [not null]
  email varchar(255) [not null, unique]

  email_verified boolean [not null, default: false, note: 'Better Auth core column.']
  image text [note: 'Better Auth core column. OPSflow reads avatar_url instead.']

  role_id uuid [not null]
  department_id uuid

  phone varchar(30)
  position varchar(100)
  avatar_url text

  status user_status [not null, default: 'active']

  joined_at date

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    role_id
    department_id
    status
  }

  Note: 'Application user profile and Better Auth identity in one table.'
}

// ============================================================
// BETTER AUTH TABLES
//
// Better Auth owns the shape of these three tables and has
// changed them between minor versions. After an upgrade, re-run
// `pnpm dlx auth@latest generate --config packages/auth/src/index.ts`
// and diff the result against the Prisma schema.
// ============================================================

Table sessions {
  id uuid [pk]

  token text [not null, unique]

  expires_at timestamptz [not null]

  ip_address text
  user_agent text

  user_id uuid [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    user_id
  }

  Note: 'One row per active sign-in. Owned by Better Auth.'
}

Table accounts {
  id uuid [pk]

  issuer text [not null, note: 'OAuth issuer URL, or local:credential for email + password.']
  account_id text [not null]
  provider_id text [not null]

  user_id uuid [not null]

  access_token text
  refresh_token text
  id_token text

  access_token_expires_at timestamptz
  refresh_token_expires_at timestamptz

  scope text

  password text [note: 'Hashed credential password. Never stored on users.']

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (issuer, account_id) [unique]
    user_id
  }

  Note: 'Credentials behind a user. Better Auth 1.7.2 keys these on (issuer, account_id).'
}

Table verifications {
  id uuid [pk]

  identifier text [not null]
  value text [not null]

  expires_at timestamptz [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    identifier
  }

  Note: 'Email verification and password reset tokens. No foreign key to users.'
}

Table rate_limits {
  id uuid [pk]

  key text [not null, unique]
  count int [not null]
  last_request bigint [not null]

  Note: 'Better Auth request counter, shared across API instances. Production only.'
}

// ============================================================
// CLIENTS
// ============================================================

Table clients {
  id uuid [pk]

  name varchar(150) [not null]
  company varchar(200)

  email varchar(255)
  phone varchar(30)

  address text

  status client_status [not null, default: 'active']

  notes text

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    status
  }

  Note: 'External clients or organizations associated with projects.'
}

// ============================================================
// PROJECTS
// ============================================================

Table projects {
  id uuid [pk]

  name varchar(200) [not null]
  description text

  client_id uuid
  manager_id uuid

  status project_status [not null, default: 'planning']

  priority priority_level [not null, default: 'medium']

  progress integer [not null, default: 0, note: 'Value between 0 and 100.']

  start_date date
  deadline date

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    client_id
    manager_id
    status
    deadline
  }

  Note: 'Core operational projects managed within OPSflow.'
}

// ============================================================
// PROJECT MEMBERS
// ============================================================

Table project_members {
  id uuid [pk]

  project_id uuid [not null]
  user_id uuid [not null]

  joined_at timestamptz [not null, default: `now()`]

  indexes {
    (project_id, user_id) [unique]
    user_id
  }

  Note: 'Many-to-many between users and projects. The composite unique also serves lookups by project, so project_id needs no separate index.'
}

// ============================================================
// TASKS
// ============================================================

Table tasks {
  id uuid [pk]

  project_id uuid [not null]
  assigned_to uuid
  created_by uuid

  title varchar(200) [not null]
  description text

  status task_status [not null, default: 'pending']

  priority priority_level [not null, default: 'medium']

  due_date date
  completed_at timestamptz

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    project_id
    assigned_to
    status
    due_date
  }

  Note: 'Operational tasks belonging to projects and assigned to users.'
}

// ============================================================
// ACTIVITY LOGS
// ============================================================

Table activity_logs {
  id uuid [pk]

  user_id uuid

  action varchar(100) [not null]

  entity_type varchar(50) [not null]
  entity_id uuid

  description text

  metadata jsonb

  created_at timestamptz [not null, default: `now()`]

  indexes {
    user_id
    (entity_type, entity_id)
    created_at
  }

  Note: 'Audit-style activity history. Never updated, so there is no updated_at.'
}

// ============================================================
// NOTIFICATIONS
// ============================================================

Table notifications {
  id uuid [pk]

  user_id uuid [not null]

  title varchar(200) [not null]
  message text [not null]

  type notification_type [not null]

  is_read boolean [not null, default: false]

  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, is_read)
    created_at
  }

  Note: 'User-specific system notifications. The composite index serves the hot query: unread notifications for one user.'
}

// ============================================================
// COMMENTS
// ============================================================

Table comments {
  id uuid [pk]

  task_id uuid
  project_id uuid
  user_id uuid

  body text [not null]

  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null]

  indexes {
    (task_id, created_at)
    (project_id, created_at)
    user_id
  }

  Note: 'The discussion thread under a task or a project. Exactly one of task_id / project_id is set, enforced by the hand-written CHECK constraint comments_one_parent_check. Each composite index serves one thread, oldest first.'
}

// ============================================================
// RELATIONSHIPS
//
// Delete behaviour is explicit on every relation and mirrors
// the onDelete rules in the Prisma schema.
// ============================================================

// A role cannot be deleted while users are assigned to it.
Ref user_role: users.role_id > roles.id [delete: restrict]

// Removing a department leaves its members in place, unassigned.
Ref user_department: users.department_id > departments.id [delete: set null]

// Better Auth records do not outlive their user.
Ref session_user: sessions.user_id > users.id [delete: cascade]
Ref account_user: accounts.user_id > users.id [delete: cascade]

// Archiving a client or removing a manager must not destroy project history.
Ref project_client: projects.client_id > clients.id [delete: set null]
Ref project_manager: projects.manager_id > users.id [delete: set null]

// Membership is meaningless without both sides.
Ref project_members_project: project_members.project_id > projects.id [delete: cascade]
Ref project_members_user: project_members.user_id > users.id [delete: cascade]

// Tasks belong to their project, but survive the people involved.
Ref task_project: tasks.project_id > projects.id [delete: cascade]
Ref task_assignee: tasks.assigned_to > users.id [delete: set null]
Ref task_creator: tasks.created_by > users.id [delete: set null]

// The audit trail outlives the user who created it.
Ref activity_user: activity_logs.user_id > users.id [delete: set null]

// Notifications are addressed to one user and die with them.
Ref notification_user: notifications.user_id > users.id [delete: cascade]

// A thread belongs to its parent and goes with it.
Ref comment_task: comments.task_id > tasks.id [delete: cascade]
Ref comment_project: comments.project_id > projects.id [delete: cascade]

// A comment outlives the person who wrote it.
Ref comment_author: comments.user_id > users.id [delete: set null]

// ============================================================
// SEED DATA
//
// Roles and departments are seeded by packages/db/prisma/seed.ts;
// development users by packages/auth/scripts/seed-users.ts.
// Both run through `pnpm db:seed`.
// ============================================================
