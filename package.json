{
  "name": "opsflow",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @opsflow/db run generate",
    "db:migrate": "pnpm --filter @opsflow/db run migrate",
    "db:seed": "pnpm --filter @opsflow/db run seed && pnpm --filter @opsflow/auth run seed",
    "db:studio": "pnpm --filter @opsflow/db run studio",
    "db:bench": "pnpm --filter @opsflow/db run bench",
    "db:explain": "pnpm --filter @opsflow/api run explain",
    "db:reset": "pnpm --filter @opsflow/db run reset",
    "bootstrap:admin": "pnpm --filter @opsflow/auth run create-admin"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "turbo": "2.10.12",
    "typescript": "7.0.2"
  }
}
