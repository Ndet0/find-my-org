# ---------------------------------------------------------------
# Copy to .env and adjust. .env is gitignored and must stay that way.
# ---------------------------------------------------------------

# Database — matches docker-compose.yml (port 5434 to avoid local clashes)
DATABASE_URL="postgresql://opsflow:opsflow@localhost:5434/opsflow?schema=public"

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-string"
BETTER_AUTH_URL="http://localhost:3000"

# API. A deployment platform that assigns its own port injects PORT, which
# the API prefers over API_PORT.
API_PORT=3000

# Web (browser-exposed; never put secrets behind a VITE_ prefix)
WEB_URL="http://localhost:5173"
VITE_API_URL="http://localhost:3000"

# Mobile (Expo inlines EXPO_PUBLIC_* at bundle time; also public).
# In development the host is taken from the Expo dev server the device
# reached, so a changing LAN address needs no edit here; only the scheme,
# port and path are read from this value. Release builds use it verbatim.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# First administrator, read only by `pnpm bootstrap:admin` on a database that
# has none. Set these in the deployment platform, not in a file: there is no
# other way into a fresh production database, because signup is closed and
# the development seed refuses to run in production.
# ADMIN_NAME="Ada Admin"
# ADMIN_EMAIL="admin@example.com"
# ADMIN_PASSWORD=""
