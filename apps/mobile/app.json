{
  "expo": {
    "name": "OPSflow",
    "slug": "opsflow",
    "version": "0.0.0",
    "scheme": "opsflow",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-secure-store"]
  }
}
