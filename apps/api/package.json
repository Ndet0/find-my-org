{
  "name": "@opsflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch --env-file=../../.env src/index.ts",
    "start": "bun run --env-file=../../.env src/index.ts",
    "build": "bun build src/index.ts --target=bun --outdir=dist",
    "typecheck": "tsc --noEmit",
    "test": "bun --env-file=../../.env test",
    "explain": "bun run --env-file=../../.env scripts/explain.ts"
  },
  "dependencies": {
    "@hono/zod-validator": "0.9.0",
    "@opsflow/auth": "workspace:*",
    "@opsflow/db": "workspace:*",
    "@opsflow/types": "workspace:*",
    "hono": "4.13.5",
    "zod": "4.5.2"
  },
  "devDependencies": {
    "@opsflow/config": "workspace:*",
    "@types/bun": "latest",
    "typescript": "7.0.2"
  }
}
